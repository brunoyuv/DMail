--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,7 +25,7 @@
 endif()
 
 project(SwiftFoundation
-    LANGUAGES C Swift)
+    LANGUAGES C Swift CXX)
 
 if(NOT SWIFT_SYSTEM_NAME)
   if(CMAKE_SYSTEM_NAME STREQUAL Darwin)
@@ -148,3 +148,21 @@
 
 add_subdirectory(Sources)
 add_subdirectory(cmake/modules)
+
+# Huawei's CMake toolchain emits native Clang driver flags at link time.
+if(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+    find_package(SwiftCore CONFIG REQUIRED)
+    foreach(runtime_target FoundationEssentials FoundationInternationalization _FoundationCollections)
+        if(TARGET ${runtime_target})
+            set_target_properties(${runtime_target} PROPERTIES LINKER_LANGUAGE CXX)
+            target_link_libraries(${runtime_target} PRIVATE swiftCore)
+        endif()
+    endforeach()
+    foreach(foundation_target FoundationEssentials FoundationInternationalization)
+        target_link_directories(${foundation_target} PRIVATE
+            "${HarmonySwiftSDK}/lib/swift/musl/${CMAKE_SYSTEM_PROCESSOR}" "${HarmonySwiftSDK}/lib")
+        target_link_libraries(${foundation_target} PRIVATE
+            swift_Concurrency swiftMusl swiftSynchronization
+            swift_StringProcessing swift_RegexParser fts)
+    endforeach()
+endif()
