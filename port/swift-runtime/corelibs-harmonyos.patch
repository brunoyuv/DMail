+// Adapted from Wes Tarle's upstream Swift PR #5491 (13899dd72ac76d3129272567f678cfaa74a2cec3).
+// Keep the callback owner alive while curl closes TLS connections.
+extension URLSession {
+    internal final class _MultiHandle {
+        private let impl: _MultiHandleImpl
+
+        init(configuration: URLSession._Configuration, workQueue: DispatchQueue) {
+            impl = _MultiHandleImpl(configuration: configuration, workQueue: workQueue)
+        }
+
+        deinit {
+            nonisolated(unsafe) let owner = impl
+            owner.queue.async {
+                owner.isClosing = true
+                owner.timeoutSource = nil
+                owner.easyHandles.forEach {
+                    try! CFURLSessionMultiHandleRemoveHandle(owner.rawHandle, $0.rawHandle).asError()
+                }
+                owner.easyHandles.removeAll()
+                try! CFURLSessionMultiHandleDeinit(owner.rawHandle).asError()
+            }
+        }
+
+        func add(_ handle: _EasyHandle) { impl.add(handle) }
+        func remove(_ handle: _EasyHandle) { impl.remove(handle) }
+    }
+}
