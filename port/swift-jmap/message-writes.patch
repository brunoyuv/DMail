+    private func writableAccount() throws -> (Session, String) {
+        guard let session, let id = selectedAccountID(in: session), let account = session.accounts[id] else {
+            throw JMAPError.method(.accountNotFound)
+        }
+        guard !account.isReadOnly else { throw JMAPError.method(.accountReadOnly) }
+        return (session, id)
+    }
+    private func changeSnapshot(_ id: String) async throws -> (Email, String) {
+        guard Self.validChangeID(id) else { throw JMAPError.method(.invalidArguments) }
+        let response = try await getEmails([id])
+        let emails = try response.decode([Email].self)
+        if emails.isEmpty && response.notFound == [id] { throw JMAPError.set(.notFound) }
+        guard emails.count == 1, emails[0].id == id, response.notFound.isEmpty,
+              !emails[0].mailboxIDs.isEmpty,
+              emails[0].mailboxIDs.allSatisfy({ Self.validChangeID($0.key) && $0.value }) else {
+            throw URLError(.cannotDecodeContentData)
+        }
+        return (emails[0], response.state)
+    }
+    private func changeMailboxes() async throws -> [Mailbox] {
+        let boxes = try await mailboxes()
+        guard boxes.allSatisfy({ Self.validChangeID($0.id) }), Set(boxes.map(\.id)).count == boxes.count else {
+            throw URLError(.cannotDecodeContentData)
+        }
+        return boxes
+    }
+    private static func validChangeID(_ id: String) -> Bool {
+        !id.isEmpty && id.utf8.count <= 255 && id.utf8.allSatisfy {
+            (48...57).contains($0) || (65...90).contains($0) || (97...122).contains($0) || $0 == 45 || $0 == 95
+        }
+    }
+    private func updateEmail(_ id: String, patch: [String: Any], ifInState: String) async throws -> String {
+        let (session, accountID) = try writableAccount()
+        guard let response = try await urlSession.jmapAPI([
+            Email.SetMethod(accountID, actions: [.update([id: patch])], ifInState: ifInState)
+        ], url: session.apiURL, authorization: server.authorization!, maxRequestBytes: session.capabilities[.core]?.maxSizeRequest).first as? MethodSetResponse else {
+            throw URLError(.cannotDecodeContentData)
+        }
+        let reported = response.updated + response.notUpdated.keys
+        guard reported.count == 1, reported[0] == id, response.created.isEmpty,
+              response.destroyed.isEmpty, response.notCreated.isEmpty, response.notDestroyed.isEmpty else {
+            throw URLError(.cannotDecodeContentData)
+        }
+        if let error = response.notUpdated[id] { throw JMAPError.set(error) }
+        return response.newState
+    }
