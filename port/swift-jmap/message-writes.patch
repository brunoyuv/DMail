+    /// Patch one explicit keyword, preserving other keywords and memberships.
+    public func setKeyword(_ keyword: Email.Keyword, enabled: Bool, for id: String) async throws -> String {
+        _ = try writableAccount()
+        guard keyword == .seen || keyword == .flagged else { throw JMAPError.method(.invalidArguments) }
+        let boxes = try await changeMailboxes()
+        let (mail, state) = try await changeSnapshot(id)
+        guard mail.mailboxIDs.keys.allSatisfy({ id in
+            guard let box = boxes.first(where: { $0.id == id }) else { return false }
+            return keyword == .seen ? box.rights.maySetSeen : box.rights.maySetKeywords
+        }) else { throw JMAPError.set(.forbidden) }
+        return try await updateEmail(id, patch: ["keywords/\(keyword.rawValue)": enabled ? true : NSNull()], ifInState: state)
+    }
+
+    public func archiveEmail(_ id: String) async throws -> ArchiveUndo {
+        let (_, accountID) = try writableAccount()
+        let boxes = try await changeMailboxes()
+        let (mail, state) = try await changeSnapshot(id)
+        let inboxes = boxes.filter { $0.role == .inbox }, archives = boxes.filter { $0.role == .archive }
+        guard inboxes.count == 1, archives.count == 1 else { throw MessageChangeError.archiveUnavailable }
+        let inbox = inboxes[0], archive = archives[0]
+        let added = mail.mailboxIDs[archive.id] != true
+        guard inbox.id != archive.id, mail.mailboxIDs[inbox.id] == true, inbox.rights.mayRemoveItems,
+              !added || archive.rights.mayAddItems else { throw MessageChangeError.archiveUnavailable }
+        var patch: [String: Any] = ["mailboxIds/\(inbox.id)": NSNull()]
+        if added { patch["mailboxIds/\(archive.id)"] = true }
+        _ = try await updateEmail(id, patch: patch, ifInState: state)
+        return ArchiveUndo(accountID: accountID, emailID: id, inboxID: inbox.id, archiveID: archive.id,
+            addedArchive: added, expectedMailboxIDs: (mail.mailboxIDs.keys.filter { $0 != inbox.id } + (added ? [archive.id] : [])).sorted())
+    }
+
+    @discardableResult public func undoArchive(_ undo: ArchiveUndo) async throws -> String {
+        let (_, accountID) = try writableAccount()
+        guard accountID == undo.accountID, [undo.emailID, undo.inboxID, undo.archiveID].allSatisfy(Self.validChangeID),
+              undo.inboxID != undo.archiveID, undo.expectedMailboxIDs.allSatisfy(Self.validChangeID),
+              Set(undo.expectedMailboxIDs).count == undo.expectedMailboxIDs.count,
+              !undo.expectedMailboxIDs.contains(undo.inboxID), undo.expectedMailboxIDs.contains(undo.archiveID) else {
+            throw JMAPError.method(.invalidArguments)
+        }
+        let boxes = try await changeMailboxes()
+        guard boxes.first(where: { $0.id == undo.inboxID })?.rights.mayAddItems == true,
+              !undo.addedArchive || boxes.first(where: { $0.id == undo.archiveID })?.rights.mayRemoveItems == true else {
+            throw JMAPError.set(.forbidden)
+        }
+        let (mail, state) = try await changeSnapshot(undo.emailID)
+        guard Set(mail.mailboxIDs.keys) == Set(undo.expectedMailboxIDs) else { throw JMAPError.method(.stateMismatch) }
+        var patch: [String: Any] = ["mailboxIds/\(undo.inboxID)": true]
+        if undo.addedArchive { patch["mailboxIds/\(undo.archiveID)"] = NSNull() }
+        return try await updateEmail(undo.emailID, patch: patch, ifInState: state)
