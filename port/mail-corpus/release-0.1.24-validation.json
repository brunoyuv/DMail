  "pictureCacheBenchmark": {
    "scope": "Synthetic host-only PictureCache inventory optimization; no real accounts, devices, or battery measurements",
    "recordedAt": "2026-09-15",
    "provenance": "Recorded from the before/after measurements already executed and reported in this task. This record was written later without rerunning the benchmark. Durations below retain the previously reported rounded values; the original one-shot benchmark script was not retained.",
    "implementation": "harmony/entry/src/main/ets/data/PictureCache.ets",
    "regressionScript": "tests/picture-cache.test.cjs",
    "regressionTests": [
      "Saving small pictures reads one budget scalar without transferring the account image inventory",
      "Pooled budget eviction reads only required oldest victims and excludes the incoming replacement"
    ],
    "fixture": {
      "runtime": "Host Node.js executing transpiled production PictureCache.ets against actual SQLite",
      "database": "Synthetic account-local image rows in SQLite",
      "transport": "Mock HTTP returning a valid 76-byte PNG, no external network",
      "newImagesPerCase": 16,
      "existingImagesPerCase": [
        0,
        1000,
        4000,
        8000
      ],
      "accountBudgetBytes": 134217728,
      "evictionExpected": false,
      "costCounter": "Image-identity inventory rows transferred through the database result interface into JavaScript, plus new scalar budget reads"
    },
    "results": [
      {
        "existingImages": 0,
        "beforeMs": 1.15,
        "afterMs": 0.95,
        "beforeInventoryRows": 120,
        "afterInventoryRows": 0,
        "afterBudgetScalars": 16
      },
      {
        "existingImages": 1000,
        "beforeMs": 11.07,
        "afterMs": 3.43,
        "beforeInventoryRows": 16120,
        "afterInventoryRows": 0,
        "afterBudgetScalars": 16
      },
      {
        "existingImages": 4000,
        "beforeMs": 41.55,
        "afterMs": 9.68,
        "beforeInventoryRows": 64120,
        "afterInventoryRows": 0,
        "afterBudgetScalars": 16
      },
      {
        "existingImages": 8000,
        "beforeMs": 78.52,
        "afterMs": 18.41,
        "beforeInventoryRows": 128120,
        "afterInventoryRows": 0,
        "afterBudgetScalars": 16
      }
    ],
    "change": {
      "before": "Every saved image selected the account image inventory in SQL eviction order and transferred all rows into JavaScript to total bytes and choose victims.",
      "after": "One SQL SUM scalar determines the account budget; only over-budget saves retrieve oldest victim identities, stopping after enough bytes are evicted.",
      "index": "picture_cache_expiry(account_id, saved_at, message_key, url)",
      "queryPlanObservation": "The tested oldest-victim query used the index without a temporary sort."
    },
    "boundsAndLimitations": [
      "Under-budget saves now transfer one scalar per image, independent of existing image count; they avoid the ordered full-inventory result and JavaScript row iteration.",
      "SQL SUM still scans the applicable account rows inside SQLite; this does not make total database work constant-time.",
      "Over-budget saves transfer only selected victim identities and delete only the required victims, preserving timestamp/message-key/URL ordering and incoming-image self-protection.",
      "The separate regression uses a file-backed WAL database and a committed-only reader to verify account isolation, expiry, replacement and eviction guards.",
      "Host timings are synthetic elapsed-time evidence, not HarmonyOS CPU, battery, thermal or real-mail measurements.",
      "The benchmark was not rerun when this record was created, and the original one-shot measurement script is unavailable. The committed regression script exercises the production implementation and deterministic inventory bounds."
    ]
  },
