#!/usr/bin/env bash
# Source after ROOT is resolved. HAP builds use CLI 26; Swift native scripts
# deliberately retain their separately pinned API 22 sysroot and libraries.
THUNDERBIRD_BUILD_TOOLS="$ROOT/.tools/deveco-26/command-line-tools"
if [[ ! -x "$THUNDERBIRD_BUILD_TOOLS/bin/hvigorw" ]]; then
  echo 'CLI 26 is missing. Run scripts/setup after downloading the documented bundle.' >&2
  exit 1
fi
export THUNDERBIRD_BUILD_TOOLS
export HVIGOR_USER_HOME="$ROOT/.tools/hvigor-home-26"
export DEVECO_SDK_HOME="$THUNDERBIRD_BUILD_TOOLS/sdk"
export DEVECO_NODE_HOME="$THUNDERBIRD_BUILD_TOOLS/tool/node"
export PATH="$DEVECO_NODE_HOME/bin:$PATH"
