#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
./scripts/prepare-imap-host
export SWIFTPM_MODULECACHE_OVERRIDE="$ROOT/.tools/swift-probe/host-imap/module-cache"
exec "$ROOT/.tools/swift/usr/bin/swift" test --package-path "$ROOT/.tools/swift-probe/host-imap/package" \
 --cache-path "$ROOT/.tools/swift-probe/host-imap/cache" --config-path "$ROOT/.tools/swift-probe/config" \
 --security-path "$ROOT/.tools/swift-probe/security" --disable-netrc --disable-sandbox -j 4 \
 -Xlinker "-L$(dirname "$(g++ -print-file-name=libstdc++.so)")" \
 -Xcxx "--gcc-install-dir=$(dirname "$(g++ -print-libgcc-file-name)")" "$@"
