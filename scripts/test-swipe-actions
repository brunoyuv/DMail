#!/usr/bin/env bash
# Bounded isolated synthetic UI; never inspect production mail or change boundary view.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${HDC_TARGET:?Set the authorized MatePad or bounded emulator target}"
HDC="$ROOT/.tools/deveco-26/command-line-tools/sdk/default/openharmony/toolchains/hdc"
APP="$ROOT/.tools/imap-test-app-aarch64"; CPU=aarch64; SIGNATURE=signed; PREFIX=matepad; RUNNER=SwipeActionsRunner
if [[ "${THUNDERBIRD_EMULATOR_TEST:-}" == 1 ]]; then
  [[ "$HDC_TARGET" == 127.0.0.1:5555 ]]
  APP="$ROOT/.tools/imap-test-app"; CPU=x86_64; SIGNATURE=unsigned; PREFIX=emulator; RUNNER=SwipeActionsEmulatorRunner
else
  [[ "$HDC_TARGET" == "${DMAIL_AUTHORIZED_MATEPAD_SERIAL:?Set the separately verified authorized MatePad serial}" ]]
fi
run_hdc() { timeout --foreground --kill-after=3s 20s "$HDC" "$@"; }
[[ "$(run_hdc -t "$HDC_TARGET" shell uname -m | tr -d '[:space:]')" == "$CPU" ]]
if [[ "$PREFIX" == matepad ]]; then
  [[ "$(run_hdc -t "$HDC_TARGET" shell param get const.product.model | tr -d '[:space:]')" == MRO-W00 ]]
fi
for hap in "default/entry-default-${SIGNATURE}.hap" "ohosTest/entry-ohosTest-${SIGNATURE}.hap"; do
  [[ -f "$APP/entry/build/default/outputs/$hap" ]] || { echo 'Build both isolated swipe test HAPs first.' >&2; exit 1; }
done
OUT="$ROOT/.tools/${PREFIX}-swipe-actions"
mkdir -p "$OUT"
if [[ -f "$OUT/test.log" ]]; then
  PREVIOUS="$(mktemp -d "$OUT/attempt.XXXXXX")"
  find "$OUT" -maxdepth 1 -type f -exec mv -t "$PREVIOUS" {} +
fi
INSTALLED=false
cleanup() {
  local result=$?
  trap - EXIT
  for name in read-open unread-open star-open held final; do
    run_hdc -t "$HDC_TARGET" file recv "/data/local/tmp/swipe-actions-$name.png" "$OUT/$name.png" >/dev/null 2>&1 || true
  done
  if "$INSTALLED"; then run_hdc -t "$HDC_TARGET" uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true; fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
run_hdc -t "$HDC_TARGET" uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true
run_hdc -t "$HDC_TARGET" install "$APP/entry/build/default/outputs/default/entry-default-${SIGNATURE}.hap"
INSTALLED=true
run_hdc -t "$HDC_TARGET" install "$APP/entry/build/default/outputs/ohosTest/entry-ohosTest-${SIGNATURE}.hap"
for name in read-open unread-open star-open held final; do
  run_hdc -t "$HDC_TARGET" shell rm -f "/data/local/tmp/swipe-actions-$name.png"
done
timeout --foreground --kill-after=5s 75s "$HDC" -t "$HDC_TARGET" shell aa test \
  -b org.thunderbird.harmony.imaptest -m entry_test -s unittest "/ets/testrunner/$RUNNER" \
  -s timeout 65000 | tee "$OUT/test.log"
grep -q 'Tests run: 1, Failure: 0, Error: 0, Pass: 1, Ignore: 0' "$OUT/test.log"
for name in read-open unread-open star-open held final; do
  run_hdc -t "$HDC_TARGET" file recv "/data/local/tmp/swipe-actions-$name.png" "$OUT/$name.png" >/dev/null
done
python3 - "$OUT" <<'PY'
from pathlib import Path
import hashlib,json,re,sys
out=Path(sys.argv[1]); log=(out/'test.log').read_text()
steps=[json.loads(raw) for raw in re.findall(r'SWIPE_ACTION_STEP: (\{[^\r\n]+\})',log)]
bounds=[json.loads(raw) for raw in re.findall(r'SWIPE_ACTION_BOUNDS: (\{[^\r\n]+\})',log)]
assert len(steps)==len(bounds)==4
calls=[]
for index,(step,bound) in enumerate(zip(steps,bounds)):
    keyword='$seen' if index<2 else '$flagged'; enabled=index%2==0
    calls.append(f'Beta:setKeyword:{keyword}:{str(enabled).lower()}')
    assert step['index']==bound['index']==index
    assert step['keyword']==keyword and step['enabled']==enabled
    assert step['calls']==','.join(calls) and step['pending']==step['violations']==0
    assert step['held']==(index==1)
    assert bound['actionEnabled'] is True
    row,button,density=bound['row'],bound['button'],bound['density']
    assert 44*density <= row['bottom']-row['top'] <= 135*density
    assert abs(button['top']-row['top'])<=2 and abs(button['bottom']-row['bottom'])<=2
    assert button['left'] < bound['x'] < button['right'] and button['top'] < bound['y'] < button['bottom']
screens={}
for name in ['read-open','unread-open','star-open','held','final']:
    data=(out/f'{name}.png').read_bytes(); assert data.startswith(b'\x89PNG\r\n\x1a\n')
    screens[name]=hashlib.sha256(data).hexdigest()
(out/'result.json').write_text(json.dumps({'tests':1,'steps':steps,'bounds':bounds,'screenshots':screens,
    'scope':'Read/Unread and Star/Unstar center/edge taps; pending double-tap dispatches once; exact four fake acknowledgements, no reader opening or body/network fetch, cached bodies preserved; global boundary view untouched'},indent=2)+'\n')
print('PASS: native swipe action geometry, repeated toggles, and pending double-tap dispatch.')
PY
