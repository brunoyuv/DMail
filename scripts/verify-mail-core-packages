#!/usr/bin/env python3
"""Check that app and protocol tests load one identical original Swift mail core."""
from pathlib import Path
import hashlib, json, subprocess, zipfile
root=Path(__file__).resolve().parent.parent
core=root/'harmony/entry/libs/x86_64/libThunderbirdCore.so'; content=core.read_bytes()
digest=hashlib.sha256(content).hexdigest()
symbols=subprocess.check_output([str(root/'.tools/command-line-tools/sdk/default/openharmony/native/llvm/bin/llvm-nm'),
    '-D','--defined-only',str(core)],text=True)
for module in ['4IMAP','4JMAP','4MIME','12EmailAddress','14HarmonyLogging','15ImapAccountCore']:
    assert '$s'+module in symbols, module
assert 'thunderbird_imap_probe' not in symbols and 'IMAPProbe' not in symbols
assert 'thunderbird_network_probe' not in symbols
assert 'thunderbird_imap_account_request' in symbols
runtime={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in core.parent.iterdir() if '.so' in p.name}
record={'coreSha256':digest,'sourceModules':['EmailAddress','MIME','JMAP','IMAP','Account (3 body files)'],
        'runtimeLibraries':runtime,'packages':{}}
for project in ['harmony','.tools/network-test-app','.tools/imap-test-app']:
    hap=root/project/'entry/build/default/outputs/default/entry-default-unsigned.hap'
    with zipfile.ZipFile(hap) as z:
        names=z.namelist(); entries=[n for n in names if n.endswith('/libThunderbirdCore.so')]
        assert len(entries)==1 and z.read(entries[0])==content, hap
        for name, expected in runtime.items():
            packaged=[n for n in names if n.endswith('/'+name)]
            assert len(packaged)==1 and hashlib.sha256(z.read(packaged[0])).hexdigest()==expected, (hap,name)
        assert not any(n.endswith(('/libThunderbirdIMAP.so','/libThunderbirdJMAP.so')) for n in names), hap
        if project=='harmony':
            assert not any(n.endswith(('/libIMAPProbe.so','/libNetworkProbe.so')) for n in names), hap
    record['packages'][str(hap.relative_to(root))]=hashlib.sha256(hap.read_bytes()).hexdigest()
target=root/'.tools/combined-mail-core-packages.json'
target.write_text(json.dumps(record,indent=2)+'\n')
print('PASS: all three HAPs contain the exact shipping core; standalone copies and shipping diagnostics absent.')
