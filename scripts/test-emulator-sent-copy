#!/usr/bin/env bash
# Prepare native core and both isolated HAPs before starting this bounded test.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for hap in default/entry-default-unsigned.hap ohosTest/entry-ohosTest-unsigned.hap; do
  [[ -f "$ROOT/.tools/imap-test-app/entry/build/default/outputs/$hap" ]]
done
export HDC_TARGET=127.0.0.1:5555
export EMULATOR_TEST_SECONDS=150
exec "$ROOT/scripts/with-test-emulator" "$ROOT/scripts/test-sent-copy"
