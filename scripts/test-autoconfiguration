#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$ROOT/scripts/prepare-autoconfiguration"
export SWIFTPM_MODULECACHE_OVERRIDE="$ROOT/.tools/swift-probe/autoconfiguration/module-cache"
exec "$ROOT/.tools/swift/usr/bin/swift" test --package-path "$ROOT/.tools/swift-probe/autoconfiguration/package" \
 --cache-path "$ROOT/.tools/swift-probe/autoconfiguration/cache" --config-path "$ROOT/.tools/swift-probe/config" \
 --security-path "$ROOT/.tools/swift-probe/security" --disable-netrc --disable-sandbox -j 4 \
 -Xlinker "-L$(dirname "$(g++ -print-file-name=libstdc++.so)")" "$@"
