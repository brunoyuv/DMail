#!/usr/bin/env bash
# Build both isolated HAPs before starting this bounded emulator session.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for hap in default/entry-default-unsigned.hap ohosTest/entry-ohosTest-unsigned.hap; do
  [[ -f "$ROOT/.tools/imap-test-app/entry/build/default/outputs/$hap" ]] || { echo 'Build isolated picture-transport HAPs first.' >&2; exit 1; }
done
export HDC_TARGET=127.0.0.1:5555 EMULATOR_SCREEN=pura-main EMULATOR_TEST_SECONDS=120
exec "$ROOT/scripts/with-test-emulator" "$ROOT/scripts/test-picture-transport"
