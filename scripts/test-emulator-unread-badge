#!/usr/bin/env bash
# Prepare both builds first; the wrapper always stops the emulator afterward.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for hap in default/entry-default-unsigned.hap ohosTest/entry-ohosTest-unsigned.hap; do
  [[ -f "$ROOT/.tools/imap-test-app/entry/build/default/outputs/$hap" ]] || { echo 'Build isolated unread-badge HAPs first.' >&2; exit 1; }
done
export HDC_TARGET=127.0.0.1:5555 EMULATOR_SCREEN=pura-main EMULATOR_TEST_SECONDS=120
exec "$ROOT/scripts/with-test-emulator" "$ROOT/scripts/test-unread-badge"
