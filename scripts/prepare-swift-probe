#!/usr/bin/env python3
"""Stage unmodified upstream modules and record exact source provenance."""
import hashlib
import json
import shutil
import subprocess
from pathlib import Path

root = Path(__file__).resolve().parent.parent
upstream = root / 'upstream/thunderbird-ios'
revision = '61c78d9ebe39ac5b61f31fce371bdfe8c001f7bf'
actual = subprocess.check_output(['git', '-C', str(upstream), 'rev-parse', 'HEAD'], text=True).strip()
if actual != revision:
    raise SystemExit('Upstream revision differs from the pinned probe baseline')
selected = ['Core/Sources/EmailAddress', 'Core/Sources/MIME', 'Core/Tests/EmailAddressTests', 'Core/Tests/MIMETests']
status = subprocess.check_output(['git', '-C', str(upstream), 'status', '--porcelain', '--', *selected], text=True)
if status:
    raise SystemExit('Selected upstream source contains modifications; refusing to call it unchanged')
destination = root / '.tools/swift-probe/package'
destination.mkdir(parents=True, exist_ok=True)


def copy_if_changed(source, target):
    # Preserve timestamps when reusing a staged baseline. Rewriting unchanged
    # files can invalidate a concurrent compiler's input-file checks.
    if not target.exists() or source.read_bytes() != target.read_bytes():
        shutil.copyfile(source, target)


manifest = []
for directory in selected:
    for source in sorted((upstream / directory).rglob('*')):
        if not source.is_file():
            continue
        relative = source.relative_to(upstream / 'Core')
        target = destination / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        copy_if_changed(source, target)
        manifest.append({'upstreamPath': str(source.relative_to(upstream)),
                         'sha256': hashlib.sha256(target.read_bytes()).hexdigest()})
provenance = {'repository': 'https://github.com/thunderbird/thunderbird-ios', 'revision': revision,
              'sourcePatches': [], 'files': manifest}
expected = json.loads((root / 'port/swift-probe/upstream-files.json').read_text())
if provenance != expected:
    raise SystemExit('Staged upstream files differ from the recorded source hashes')
copy_if_changed(root / 'port/swift-probe/Package.swift', destination / 'Package.swift')
(destination / 'Sources/Probe').mkdir(parents=True, exist_ok=True)
copy_if_changed(root / 'port/swift-probe/main.swift', destination / 'Sources/Probe/main.swift')
(destination.parent / 'upstream-files.json').write_text(json.dumps(provenance, indent=2) + '\n')
print(f'Staged {len(manifest)} unchanged upstream source/test/resource files at {destination}')
