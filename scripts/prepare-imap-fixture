#!/usr/bin/env python3
"""Generate private, short-lived certificates for the loopback IMAP fixture."""
from pathlib import Path
import datetime, ipaddress
from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.x509.oid import NameOID, ExtendedKeyUsageOID

certs = Path(__file__).resolve().parent.parent / '.tools/imap-test-certs'
certs.mkdir(parents=True, exist_ok=True); certs.chmod(0o700)
now = datetime.datetime.now(datetime.timezone.utc)
def issue(name, issuer_key=None, issuer=None, host=None):
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, name)])
    b = x509.CertificateBuilder().subject_name(subject).issuer_name(issuer.subject if issuer else subject)
    b = b.public_key(key.public_key()).serial_number(x509.random_serial_number())
    b = b.not_valid_before(now - datetime.timedelta(days=2)).not_valid_after(now + datetime.timedelta(days=7))
    b = b.add_extension(x509.BasicConstraints(ca=host is None, path_length=None), critical=True)
    if host:
        names = [x509.DNSName(host)]
        if host == 'localhost': names.append(x509.IPAddress(ipaddress.ip_address('127.0.0.1')))
        b = b.add_extension(x509.SubjectAlternativeName(names), critical=False)
        b = b.add_extension(x509.ExtendedKeyUsage([ExtendedKeyUsageOID.SERVER_AUTH]), critical=False)
    cert = b.sign(issuer_key or key, hashes.SHA256())
    (certs / f'{name}.crt').write_bytes(cert.public_bytes(serialization.Encoding.PEM))
    target = certs / f'{name}.key'
    target.touch(mode=0o600); target.chmod(0o600)
    target.write_bytes(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
                                       serialization.NoEncryption()))
    return key, cert
key, ca = issue('root')
issue('server', key, ca, 'localhost'); issue('wrong', key, ca, 'wrong.invalid')
issue('pinwrong', key, ca, 'localhost')
other_key, other_ca = issue('other-root'); issue('untrusted', other_key, other_ca, 'localhost')
print('Prepared local IMAP fixture certificates; no system trust changes.')
