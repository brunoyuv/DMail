#!/usr/bin/env python3
"""Generate an isolated test app and app-scoped TLS fixtures (not the mail HAP)."""
from pathlib import Path
import datetime, ipaddress, json, shutil
from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.x509.oid import NameOID

root = Path(__file__).resolve().parent.parent
app = root / '.tools/network-test-app'
certs = root / '.tools/network-test-certs'
certs.mkdir(parents=True, exist_ok=True)
certs.chmod(0o700)
now = datetime.datetime.now(datetime.timezone.utc)
def issue(name, issuer_key=None, issuer=None, host=None):
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, name)])
    builder = x509.CertificateBuilder().subject_name(subject).issuer_name(issuer.subject if issuer else subject)
    builder = builder.public_key(key.public_key()).serial_number(x509.random_serial_number())
    builder = builder.not_valid_before(now - datetime.timedelta(days=2)).not_valid_after(now + datetime.timedelta(days=30))
    builder = builder.add_extension(x509.BasicConstraints(ca=host is None, path_length=None), critical=True)
    if host is not None:
        names = [x509.DNSName(host)]
        if host == 'localhost': names.append(x509.IPAddress(ipaddress.ip_address('127.0.0.1')))
        builder = builder.add_extension(x509.SubjectAlternativeName(names), critical=False)
        builder = builder.add_extension(x509.ExtendedKeyUsage([x509.oid.ExtendedKeyUsageOID.SERVER_AUTH]), critical=False)
    cert = builder.sign(issuer_key or key, hashes.SHA256())
    (certs / f'{name}.crt').write_bytes(cert.public_bytes(serialization.Encoding.PEM))
    p = certs / f'{name}.key'
    p.write_bytes(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))
    p.chmod(0o600)
    return key, cert
key, ca = issue('root')
issue('server', key, ca, 'localhost')
issue('wrong', key, ca, 'wrong.invalid')
other_key, other = issue('other-root')
issue('untrusted', other_key, other, 'localhost')

def write(name, text):
    p = app / name; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(text)
def data(name, value): write(name, json.dumps(value, indent=2) + '\n')
def copy(source, name):
    p = app / name; p.parent.mkdir(parents=True, exist_ok=True); shutil.copy2(root / source, p)
for name in ['build-profile.json5', 'hvigorfile.ts', 'hvigor/hvigor-config.json5', 'oh-package.json5', 'entry/hvigorfile.ts']:
    copy('harmony/' + name, name)
data('AppScope/app.json5', {'app': {'bundleName': 'org.thunderbird.harmony.nettest', 'vendor': 'D-Mail tests', 'versionCode': 1, 'versionName': '0.1.0', 'icon': '$media:app_icon', 'label': '$string:app_name'}})
copy('harmony/AppScope/resources/base/media/app_icon.svg', 'AppScope/resources/base/media/app_icon.svg')
data('AppScope/resources/base/element/string.json', {'string': [{'name':'app_name','value':'D-Mail network tests'}]})
data('entry/oh-package.json5', {'name':'entry','version':'0.1.0','dependencies': {'libnetworktest.so':'file:./src/main/cpp/types/libnetworktest', 'libthunderbird.so':'file:./src/main/cpp/types/libthunderbird'}})
data('entry/src/main/cpp/types/libnetworktest/oh-package.json5', {'name':'libnetworktest.so','version':'0.1.0','types':'./index.d.ts'})
write('entry/src/main/cpp/types/libnetworktest/index.d.ts', 'export const request: (input: string) => Promise<string>;\n')
data('entry/build-profile.json5', {'apiType':'stageMode','buildOption': {'externalNativeOptions': {'path':'./src/main/cpp/CMakeLists.txt','abiFilters':['x86_64']}, 'nativeLib': {'collectAllLibs':True,'debugSymbol':{'strip':False}}},'targets':[{'name':'default'},{'name':'ohosTest'}]})
data('entry/src/main/module.json5', {'module': {'name':'entry','type':'entry','mainElement':'EntryAbility','deviceTypes':['phone'],'deliveryWithInstall':True,'installationFree':False,'requestPermissions':[{'name':'ohos.permission.INTERNET'}],'abilities':[{'name':'EntryAbility','srcEntry':'./ets/entryability/EntryAbility.ets','exported':True,'startWindowIcon':'$media:app_icon','startWindowBackground':'$color:start_window_background'}]}})
write('entry/src/main/ets/entryability/EntryAbility.ets', "import { UIAbility } from '@kit.AbilityKit';\nexport default class EntryAbility extends UIAbility {}\n")
data('entry/src/main/resources/base/element/color.json', {'color':[{'name':'start_window_background','value':'#FFFFFF'}]})
data('entry/src/ohosTest/module.json5', {'module': {'name':'entry_test','type':'feature','deviceTypes':['phone'],'deliveryWithInstall':True,'installationFree':False,'requestPermissions':[{'name':'ohos.permission.INTERNET'}], 'abilities':[{'name':'NetworkTestAbility','srcEntry':'./ets/testability/NetworkTestAbility.ets','exported':False,'startWindowIcon':'$media:app_icon','startWindowBackground':'$color:start_window_background'}]}})
write('entry/src/ohosTest/ets/testability/NetworkTestAbility.ets', "import { UIAbility } from '@kit.AbilityKit';\nexport default class NetworkTestAbility extends UIAbility {}\n")
data('entry/src/main/resources/base/profile/network_config.json', {'network-security-config': {'base-config': {'cleartextTrafficPermitted':True}, 'domain-config':[{'domains':[{'name':host,'include-subdomains':False}],'cleartextTrafficPermitted':host != 'localhost','trust-anchors':[{'certificates':'/data/storage/el2/base/files/native-network-ca'}]} for host in ['127.0.0.1','localhost']]}, 'trust-global-user-ca':False,'trust-current-user-ca':False})
copy('.tools/network-test-certs/root.crt', 'entry/src/main/resources/rawfile/root.crt')
copy('port/network-tests/NetworkTestRunner.ets', 'entry/src/ohosTest/ets/testrunner/NetworkTestRunner.ets')
copy('port/network-tests/Network.test.ets', 'entry/src/ohosTest/ets/test/Network.test.ets')
copy('port/network-tests/napi_network.cpp', 'entry/src/main/cpp/napi_network.cpp')
copy('harmony/entry/src/main/cpp/napi_init.cpp', 'entry/src/main/cpp/napi_thunderbird.cpp')
for name in ['index.d.ts', 'oh-package.json5']:
    copy('harmony/entry/src/main/cpp/types/libthunderbird/' + name, 'entry/src/main/cpp/types/libthunderbird/' + name)
for name in ['JmapClient.ts', 'NativeJmapAccountCore.ets', 'HarmonyJmapTransport.ets']:
    copy('harmony/entry/src/main/ets/mail/jmap/' + name, 'entry/src/main/ets/mail/jmap/' + name)
copy('port/swift-jmap/AccountCore.test.ets', 'entry/src/ohosTest/ets/test/AccountCore.test.ets')
copy('port/swift-jmap/ReaderCore.test.ets', 'entry/src/ohosTest/ets/test/ReaderCore.test.ets')
copy('port/swift-jmap/WriteCore.test.ets', 'entry/src/ohosTest/ets/test/WriteCore.test.ets')
copy('port/swift-jmap/DraftCore.test.ets', 'entry/src/ohosTest/ets/test/DraftCore.test.ets')

write('entry/src/main/cpp/CMakeLists.txt', '''cmake_minimum_required(VERSION 3.5.0)
project(network_test)
set(CMAKE_CXX_STANDARD 17)
add_library(NetworkProbe SHARED IMPORTED)
set_target_properties(NetworkProbe PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libNetworkProbe.so")
add_library(networktest SHARED napi_network.cpp)
target_link_libraries(networktest PUBLIC NetworkProbe libace_napi.z.so libhilog_ndk.z.so)
add_library(ThunderbirdCore SHARED IMPORTED)
set_target_properties(ThunderbirdCore PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libThunderbirdCore.so")
add_library(thunderbird SHARED napi_thunderbird.cpp)
target_link_libraries(thunderbird PUBLIC ThunderbirdCore libace_napi.z.so)
target_link_options(thunderbird PRIVATE "-Wl,--no-undefined")
''')
print('Prepared isolated network test app:', app)
