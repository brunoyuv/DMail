#!/usr/bin/env bash
# Prepared native UI and encrypted-cache tests use only in-memory synthetic mail.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
APP="$ROOT/.tools/imap-test-app"
if [[ "${THUNDERBIRD_EMULATOR_TEST:-}" != 1 ]]; then
  for hap in default/entry-default-unsigned.hap ohosTest/entry-ohosTest-unsigned.hap; do
    [[ -f "$APP/entry/build/default/outputs/$hap" ]] || { echo 'Build navigation test HAPs before starting the emulator.' >&2; exit 1; }
  done
  export EMULATOR_SCREEN=pura-main EMULATOR_TEST_SECONDS=240
  exec "$ROOT/scripts/with-test-emulator" "$0"
fi
HDC="$ROOT/.tools/deveco-26/command-line-tools/sdk/default/openharmony/toolchains/hdc"
OUT="$ROOT/.tools/navigation-native-test"
mkdir -p "$OUT"
if [[ -f "$OUT/test.log" ]]; then
  PREVIOUS="$(mktemp -d "$OUT/attempt.XXXXXX")"
  find "$OUT" -maxdepth 1 -type f -exec mv -t "$PREVIOUS" {} +
fi
UITEST_PREVIOUS=''
cleanup() {
  local result=$?
  trap - EXIT
  for name in alpha picker beta-cached beta-offline-reader beta-restored search-middle search-top search-input search-query refreshed thread-inbox thread-reader thread-quote async-switch; do
    "$HDC" -t 127.0.0.1:5555 file recv "/data/local/tmp/navigation-$name.png" "$OUT/$name.png" >/dev/null 2>&1 || true
  done
  for phase in before after; do "$HDC" -t 127.0.0.1:5555 file recv "/data/local/tmp/navigation-search-$phase.json" "$OUT/search-$phase.json" >/dev/null 2>&1 || true; done
  "$HDC" -t 127.0.0.1:5555 shell hilog -x > "$OUT/hilog.txt" 2>&1 || true
  "$HDC" -t 127.0.0.1:5555 uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true
  if [[ -n "$UITEST_PREVIOUS" ]]; then "$HDC" -t 127.0.0.1:5555 shell param set persist.ace.testmode.enabled "$UITEST_PREVIOUS" >/dev/null 2>&1 || true; fi
  if [[ "$result" == 0 ]]; then
    python3 - "$ROOT" "$OUT" <<'PY' || result=1
from pathlib import Path
import hashlib,re,struct,sys,json,zipfile
root,out=map(Path,sys.argv[1:]);log=(out/'test.log').read_text()
assert 'OHOS_REPORT_RESULT: stream=Tests run: 6, Failure: 0, Error: 0, Pass: 6, Ignore: 0' in log
for name in ['account_picker_restores_last_account_and_search_only_reveals_at_top','cached_sent_thread_quotes_and_pending_flags_survive_account_switch']:
    assert re.search(r'OHOS_REPORT_STATUS: test='+name+r'\r?\nOHOS_REPORT_STATUS_CODE: 0(?:\r?\n|$)',log)
screenshots={}
for name in ['alpha','picker','beta-cached','beta-offline-reader','beta-restored','search-middle','search-top','search-input','search-query','refreshed','thread-inbox','thread-reader','thread-quote','async-switch']:
    data=(out/f'{name}.png').read_bytes()
    assert struct.unpack('>II',data[16:24])==(1320,2120),name
    screenshots[name]=hashlib.sha256(data).hexdigest()
with zipfile.ZipFile(root/'.tools/imap-test-app/entry/build/default/outputs/default/entry-default-unsigned.hap') as hap:
    core=hap.read('libs/x86_64/libThunderbirdCore.so')
assert core==(root/'harmony/entry/libs/x86_64/libThunderbirdCore.so').read_bytes()
(out/'result.json').write_text(json.dumps({'tests':6,'nativeCoreSHA256':hashlib.sha256(core).hexdigest(),
    'screenshots':screenshots,'scope':'In-memory two-account service: isolated persisted caches, offline cached body, last-account restoration, search only at top or with query, explicit pull refresh, acknowledged star/read flags preserve cached bodies without downloads, cached received/Sent conversation and quote disclosure, pending optimistic flag completes after account switch; four encrypted storage regressions'},indent=2)+'\n')
print('PASS: account navigation, persisted caches, native search gestures, and encrypted storage.')
PY
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
UITEST_PREVIOUS="$("$HDC" -t 127.0.0.1:5555 shell param get persist.ace.testmode.enabled | tr -d '\r\n')"
[[ "$UITEST_PREVIOUS" == 1 ]] || UITEST_PREVIOUS=0
"$HDC" -t 127.0.0.1:5555 shell param set persist.ace.testmode.enabled 0
"$HDC" -t 127.0.0.1:5555 uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true
"$HDC" -t 127.0.0.1:5555 install "$APP/entry/build/default/outputs/default/entry-default-unsigned.hap"
"$HDC" -t 127.0.0.1:5555 install "$APP/entry/build/default/outputs/ohosTest/entry-ohosTest-unsigned.hap"
"$HDC" -t 127.0.0.1:5555 shell 'rm -f /data/local/tmp/navigation-*.png'
timeout --foreground --kill-after=5s 210s "$HDC" -t 127.0.0.1:5555 shell aa test \
  -b org.thunderbird.harmony.imaptest -m entry_test -s unittest /ets/testrunner/NavigationRunner \
  -s timeout 200000 | tee "$OUT/test.log"
grep -q 'Tests run: 6, Failure: 0, Error: 0, Pass: 6, Ignore: 0' "$OUT/test.log"
