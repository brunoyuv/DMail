#!/usr/bin/env bash
# Stage/build before invoking this bounded isolated native test.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for variant in default ohosTest; do
  [[ -f "$ROOT/.tools/imap-test-app/entry/build/default/outputs/$variant/entry-$variant-unsigned.hap" ]]
done
export HDC_TARGET=127.0.0.1:5555 EMULATOR_SCREEN=pura-main EMULATOR_TEST_SECONDS=100
exec "$ROOT/scripts/with-test-emulator" "$ROOT/scripts/test-html-link"
