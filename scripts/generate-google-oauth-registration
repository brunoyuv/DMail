#!/usr/bin/env python3
"""Generate private native build configuration; never print credential values."""
from pathlib import Path
import argparse, json, os
root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', required=True)
args = parser.parse_args()
source = root/'.tools/oauth/google-desktop.json'
output = Path(args.output).resolve()
assert output.is_relative_to(root/'.tools'), 'Generated credentials must stay in ignored .tools'
text = 'enum LocalGoogleOAuth { static let registration: GoogleDesktopRegistration? = nil }\n'
if source.exists():
    config = json.loads(source.read_text()).get('installed', {})
    expected = '883149639454-r1c1m28d0tatqkcn2b55qes9aossu5p6.apps.googleusercontent.com'
    assert config.get('client_id') == expected, 'Expected the registered Google Desktop client, not the TV client'
    secret = config.get('client_secret', '')
    assert isinstance(secret, str) and 0 < len(secret) <= 512 and all(32 < ord(c) < 127 for c in secret), 'Invalid Desktop client secret'
    assert config.get('token_uri') == 'https://oauth2.googleapis.com/token', 'Unexpected Google token endpoint'
    os.chmod(source, 0o600)
    # Restrict input to printable ASCII; escape interpolation/backslash/quotes
    # using Swift's normal quoted string syntax. Never embed this in a shell.
    literal = secret.replace('\\', '\\\\').replace('"', '\\"')
    text = 'enum LocalGoogleOAuth { static let registration: GoogleDesktopRegistration? = GoogleDesktopRegistration(clientID: "' + expected + '", clientSecret: "' + literal + '") }\n'
output.parent.mkdir(parents=True, exist_ok=True)
fd = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as file: file.write(text)
os.chmod(output, 0o600)
