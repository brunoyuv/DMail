project(imap_test)
set(CMAKE_CXX_STANDARD 17)
add_library(IMAPProbe SHARED IMPORTED)
set_target_properties(IMAPProbe PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libIMAPProbe.so")
add_library(imaptest SHARED napi_imap.cpp)
target_link_libraries(imaptest PUBLIC IMAPProbe libace_napi.z.so libhilog_ndk.z.so)
target_link_options(imaptest PRIVATE "-Wl,--no-undefined")
add_library(ThunderbirdCore SHARED IMPORTED)
set_target_properties(ThunderbirdCore PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libThunderbirdCore.so")
add_library(thunderbird SHARED napi_thunderbird.cpp)
target_link_libraries(thunderbird PUBLIC ThunderbirdCore libace_napi.z.so)
target_link_options(thunderbird PRIVATE "-Wl,--no-undefined")
''')
