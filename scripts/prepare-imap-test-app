copy('port/swift-imap/MathGlyphFixtures.ets','entry/src/ohosTest/ets/test/MathGlyphFixtures.ets')
copy('port/swift-imap/ComposeSettings.test.ets','entry/src/ohosTest/ets/test/ComposeSettings.test.ets')
copy('port/swift-imap/ComposeAttachments.test.ets','entry/src/ohosTest/ets/test/ComposeAttachments.test.ets')
