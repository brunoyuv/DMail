copy('port/swift-imap/IMAP.test.ets','entry/src/ohosTest/ets/test/IMAP.test.ets')
copy('port/swift-imap/OAuthImap.test.ets','entry/src/ohosTest/ets/test/OAuthImap.test.ets')
copy('port/swift-smtp/OAuthSmtp.test.ets','entry/src/ohosTest/ets/test/OAuthSmtp.test.ets')
write('entry/src/ohosTest/ets/test/MailOAuth.test.ets', "import imap from './OAuthImap.test';\nimport smtp from './OAuthSmtp.test';\nexport default function tests(): void { imap(); smtp(); }\n")
write('entry/src/ohosTest/ets/testrunner/MailOAuthRunner.ets', runner.replace('IMAPTestRunner','MailOAuthRunner').replace('../test/IMAP.test','../test/MailOAuth.test'))
write('entry/src/ohosTest/ets/testrunner/OAuthImapRunner.ets', runner.replace('IMAPTestRunner','OAuthImapRunner').replace('../test/IMAP.test','../test/OAuthImap.test'))
copy('port/swift-imap/napi_imap.cpp','entry/src/main/cpp/napi_imap.cpp')
# Clear only the generated test-app library directory, including the earlier
# standalone diagnostic. Both protocols must resolve through the shipping core.
libraries=app/f'entry/libs/{abi}'
if libraries.exists(): shutil.rmtree(libraries)
for p in (production/f'entry/libs/{abi}').iterdir():
    if '.so' in p.name: copy(str(p.relative_to(root)), f'entry/libs/{abi}/'+p.name)
copy(f'.tools/swift-probe/native-imap{suffix}/libIMAPProbe.so',f'entry/libs/{abi}/libIMAPProbe.so')
write('entry/src/main/cpp/CMakeLists.txt','''cmake_minimum_required(VERSION 3.5.0)
project(imap_test)
set(CMAKE_CXX_STANDARD 17)
add_library(IMAPProbe SHARED IMPORTED)
set_target_properties(IMAPProbe PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libIMAPProbe.so")
add_library(imaptest SHARED napi_imap.cpp)
target_link_libraries(imaptest PUBLIC IMAPProbe libace_napi.z.so libhilog_ndk.z.so)
target_link_options(imaptest PRIVATE "-Wl,--no-undefined")
add_library(ThunderbirdCore SHARED IMPORTED)
set_target_properties(ThunderbirdCore PROPERTIES IMPORTED_LOCATION "${CMAKE_CURRENT_SOURCE_DIR}/../../../libs/${OHOS_ARCH}/libThunderbirdCore.so")
add_library(thunderbird SHARED napi_thunderbird.cpp)
target_link_libraries(thunderbird PUBLIC ThunderbirdCore libace_napi.z.so)
target_link_options(thunderbird PRIVATE "-Wl,--no-undefined")
''')
print('Prepared IMAP test app:', app)

copy('port/swift-imap/MailboxLoading.test.ets','entry/src/ohosTest/ets/test/MailboxLoading.test.ets')
write('entry/src/ohosTest/ets/testrunner/MailboxLoadingRunner.ets', runner.replace('IMAPTestRunner','MailboxLoadingRunner').replace('../test/IMAP.test','../test/MailboxLoading.test'))
copy('port/swift-imap/Encoding.test.ets','entry/src/ohosTest/ets/test/Encoding.test.ets')
write('entry/src/ohosTest/ets/testrunner/EncodingRunner.ets', runner.replace('IMAPTestRunner','EncodingRunner').replace('../test/IMAP.test','../test/Encoding.test'))
