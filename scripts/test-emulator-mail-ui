#!/usr/bin/env bash
# Build first with prepare-native-app and build-imap-test-app, emulator stopped.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for hap in default/entry-default-unsigned.hap ohosTest/entry-ohosTest-unsigned.hap; do
  [[ -f "$ROOT/.tools/imap-test-app/entry/build/default/outputs/$hap" ]] || { echo 'Prepare emulator HAPs before starting this test.' >&2; exit 1; }
done
export HDC_TARGET=127.0.0.1:5555
exec "$ROOT/scripts/with-test-emulator" "$ROOT/scripts/test-device-mail-features" ui
