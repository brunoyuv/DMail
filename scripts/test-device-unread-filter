#!/usr/bin/env bash
# Repeat unread filtering in an isolated main-HAP UI over synthetic cached mail.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${HDC_TARGET:?Set HDC_TARGET to the authorized MatePad serial}"
[[ "$HDC_TARGET" == "${DMAIL_AUTHORIZED_MATEPAD_SERIAL:?Set the separately verified authorized MatePad serial}" ]]
HDC="$ROOT/.tools/deveco-26/command-line-tools/sdk/default/openharmony/toolchains/hdc"
APP="$ROOT/.tools/imap-test-app-aarch64"
OUT="$ROOT/.tools/matepad-unread-filter"
run_hdc() { timeout --foreground --kill-after=3s 30s "$HDC" "$@"; }
[[ "$(run_hdc -t "$HDC_TARGET" shell uname -m | tr -d '[:space:]')" == aarch64 ]]
[[ "$(run_hdc -t "$HDC_TARGET" shell param get const.product.model | tr -d '[:space:]')" == MRO-W00 ]]
for hap in default/entry-default-signed.hap ohosTest/entry-ohosTest-signed.hap; do
  [[ -f "$APP/entry/build/default/outputs/$hap" ]] || { echo 'Build signed test HAPs first.' >&2; exit 1; }
done
mkdir -p "$OUT"
if [[ -f "$OUT/test.log" ]]; then
  PREVIOUS="$(mktemp -d "$OUT/attempt.XXXXXX")"
  find "$OUT" -maxdepth 1 -type f -exec mv -t "$PREVIOUS" {} +
fi
INSTALLED=false
cleanup() {
  local result=$?
  trap - EXIT
  for name in top-filtered bottom-all bottom-filtered unread-thread-opened; do
    run_hdc -t "$HDC_TARGET" file recv "/data/local/tmp/unread-filter-$name.png" "$OUT/$name.png" >/dev/null 2>&1 || true
  done
  if "$INSTALLED"; then run_hdc -t "$HDC_TARGET" uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true; fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
run_hdc -t "$HDC_TARGET" uninstall org.thunderbird.harmony.imaptest >/dev/null 2>&1 || true
run_hdc -t "$HDC_TARGET" install "$APP/entry/build/default/outputs/default/entry-default-signed.hap"
INSTALLED=true
run_hdc -t "$HDC_TARGET" install "$APP/entry/build/default/outputs/ohosTest/entry-ohosTest-signed.hap"
for name in top-filtered bottom-all bottom-filtered unread-thread-opened; do
  run_hdc -t "$HDC_TARGET" shell rm -f "/data/local/tmp/unread-filter-$name.png"
done
timeout --foreground --kill-after=5s 60s "$HDC" -t "$HDC_TARGET" shell aa test \
  -b org.thunderbird.harmony.imaptest -m entry_test -s unittest /ets/testrunner/UnreadFilterRunner \
  -s timeout 50000 | tee "$OUT/test.log"
grep -q 'Tests run: 1, Failure: 0, Error: 0, Pass: 1, Ignore: 0' "$OUT/test.log"
for name in top-filtered bottom-all bottom-filtered unread-thread-opened; do
  run_hdc -t "$HDC_TARGET" file recv "/data/local/tmp/unread-filter-$name.png" "$OUT/$name.png" >/dev/null
done
python3 - "$OUT" <<'PY'
from pathlib import Path
import hashlib,json,re,sys
out=Path(sys.argv[1]); log=(out/'test.log').read_text()
records=[json.loads(raw) for raw in re.findall(r'UNREAD_FILTER_BOUNDS: (\{[^\r\n]+\})',log)]
screens={record['name']:record for record in records}
for name in ['top-filtered','bottom-all','bottom-filtered','unread-thread-opened']:
    data=(out/f'{name}.png').read_bytes(); assert data.startswith(b'\x89PNG\r\n\x1a\n')
    screens[name]['sha256']=hashlib.sha256(data).hexdigest()
    assert screens[name]['calls']==('Beta:setKeyword:$seen:true' if name=='unread-thread-opened' else '')
(out/'result.json').write_text(json.dumps({'tests':1,'scope':'Three unread-filter cycles at top, three after scrolling 40 cached messages to bottom, persistent account/filter header, older unread member chosen in a thread with newer read reply, one in-memory Seen acknowledgement and no body/server fetches','screenshots':screens},indent=2)+'\n')
print('PASS: repeated unread filtering, bottom-scroll reset, and unread conversation member selection.')
PY
